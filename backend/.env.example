# ── ตัวอย่าง .env สำหรับ backend ──
# คัดลอกเป็น `.env` แล้วแก้ค่า (ห้าม commit .env ตัวจริง)
# สร้าง secret key ใหม่ด้วย:  python -c "import secrets; print(secrets.token_hex(32))"

# ─── App ───────────────────────────────────────────────────────────
APP_ENV=dev                                # dev | prod
APP_NAME=SmartBrew POS API
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# ─── Security ──────────────────────────────────────────────────────
# ความยาว >= 32 bytes (256 bit) ตามคำแนะนำ JWT HS256
APP_SECRET_KEY=change-me-to-a-random-64-hex-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# คุกกี้ refresh token
REFRESH_COOKIE_NAME=sb_refresh
REFRESH_COOKIE_SECURE=true                 # ใน dev ตั้ง false ถ้าไม่ใช้ https
REFRESH_COOKIE_SAMESITE=lax                # lax | strict | none

# ─── CORS ──────────────────────────────────────────────────────────
# allowlist เฉพาะ origin ของ frontend คั่นด้วย , (ห้าม *)
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ─── Database ──────────────────────────────────────────────────────
# SQLite file ใน working dir; เปลี่ยนเป็น postgres ภายหลังได้
DATABASE_URL=sqlite:///./smartbrew.db
SQL_ECHO=false

# ─── Rate limit (slowapi) ──────────────────────────────────────────
RATE_LIMIT_LOGIN=10/minute

# ─── AI / Ollama ───────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b                   # เปลี่ยนเป็นรุ่นที่ pulled ไว้

# ─── Seed (สำหรับ init_db.py) ─────────────────────────────────────
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=change-me-on-first-run
